# ── Compose project name — change per environment to namespace containers ──
COMPOSE_PROJECT_NAME=travel-prod

# ── Nginx ports — change per environment if co-hosted ──
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ── Nginx config filename (without .conf) inside ./nginx/ ──
# Values: default (production domain), staging
NGINX_CONF=default

# ── Database ──
POSTGRES_PASSWORD=<strong-random-password>

# ── JWT (generate: openssl rand -base64 32) ──
JWT_SECRET=<base64-encoded-256-bit-secret>

# ── MinIO Object Storage ──
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=<minio-access-key>
MINIO_SECRET_KEY=<minio-secret-key>
MINIO_BUCKET=travel-srilanka

# ── Admin User ──
ADMIN_USERNAME=<admin-username>
ADMIN_PASSWORD=<strong-admin-password>
ADMIN_EMAIL=<admin-email>
