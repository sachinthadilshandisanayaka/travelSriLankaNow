# Non-secret client config — safe to commit to git
# Secrets (DB password, JWT, MinIO keys) live in Jenkins → Credentials → PROJ002-secrets

SERVER_IP=root@169.58.19.24
DOMAIN=roamlankatravels.com
SSH_CRED_ID=ssh-key-proj002
NGINX_CONF=nginx-ssl

# Branding — used to patch index.html OG/Twitter meta tags at deploy time
SITE_NAME=Roam Lanka Travels
SITE_TAGLINE=Discover the Pearl of the Indian Ocean
SITE_DESCRIPTION=Discover the pearl of the Indian Ocean. Explore pristine beaches, ancient temples, lush tea plantations, and vibrant wildlife with Roam Lanka Travels.

# Theme — see travelSrilankaNow/generate-theme.sh for available presets (navy, warm, gold)
THEME_PRESET=gold

# Favicon — URL to a .ico / .png file; overrides the built-in favicon at container start.
# Upload the Roam Lanka Travels logo to MinIO and paste the public URL here.
# e.g. FAVICON_URL=https://roamlankatravels.com/storage/travel-srilanka-proj002/brand/favicon.ico
FAVICON_URL=
