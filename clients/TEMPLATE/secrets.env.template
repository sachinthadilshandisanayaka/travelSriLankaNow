# ─────────────────────────────────────────────────────────────────────────────
# CLIENT SECRET TEMPLATE
# Fill this in for each client, then upload to Jenkins as a Secret File.
#   Jenkins → Credentials → Global → Add Credential
#   Kind: Secret file
#   ID:   PROJXXX-secrets      (replace XXX with project number)
#   File: this file (filled in)
#
# DO NOT commit a filled copy of this file to git.
# ─────────────────────────────────────────────────────────────────────────────

# Compose project name — must be unique per client (use project ID, lowercase)
COMPOSE_PROJECT_NAME=projXXX

# Nginx ports (80/443 when each client has their own server)
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Database
POSTGRES_PASSWORD=REPLACE_strong_unique_password

# JWT (generate: openssl rand -base64 32)
JWT_SECRET=REPLACE_jwt_secret

# MinIO — each client gets their own MinIO instance or bucket namespace
MINIO_ENDPOINT=http://YOUR_MINIO_HOST:9000
MINIO_ACCESS_KEY=REPLACE_minio_access_key
MINIO_SECRET_KEY=REPLACE_minio_secret_key
MINIO_BUCKET=travel-srilanka-projXXX

# Admin login for this client's portal
ADMIN_USERNAME=REPLACE_admin_username
ADMIN_PASSWORD=REPLACE_strong_admin_password
ADMIN_EMAIL=REPLACE_admin_email
